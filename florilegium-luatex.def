%% Native LuaTeX host for florilegium (MIT).
\AtBeginDocument{\if@twoside\directlua{florilegium.twoside=true}\fi
  \ifflorilegium@visitors\else\directlua{florilegium.visitors=false}\fi
  \directlua{florilegium.initial_fallback="\flo@fallback"}}
\def\flo@applycolors{\directlua{florilegium.colors(\flo@ink,\flo@acc)}}
\newcommand\florilegiumdraw[2]{\florilegium@colors\directlua{florilegium.draw("#1",#2)}}
\def\florilegium@seed{\directlua{tex.sprint(florilegium.seed(\number\value{page}%
  \ifx\florilegiumseed\@empty\else,\florilegiumseed\fi))}}
\newcommand\margingarden{\begin{tikzpicture}[overlay]\florilegium@colors
  \edef\flo@seed{\florilegium@seed}\directlua{florilegium.authored(\flo@seed)}\end{tikzpicture}}
\newcommand\margingardengrown{\begin{tikzpicture}[overlay]\florilegium@colors
  \edef\flo@seed{\florilegium@seed}%
  \ifflorilegium@aging\ifdefined\flo@lastpage
    \directlua{florilegium.auto_age(\number\value{page},\flo@lastpage)}\fi\fi
  \ifnum\value{page}=\flo@endpage\relax
    \directlua{florilegium.grown(\flo@seed,1,florilegium.geometry().ytop-
      \number\dimexpr\flo@endtotal\relax*2.54/(72.27*65536),\number\ShipoutBox,"\luaescapestring{\thepage}")}%
  \else\directlua{florilegium.grown(\flo@seed,0,0,\number\ShipoutBox,"\luaescapestring{\thepage}")}\fi
  \end{tikzpicture}}
\newcommand\flo@bloom[1]{\directlua{florilegium.mark("bloom","\luaescapestring{#1}")}}
\newcommand\flo@headingmark[1]{\directlua{florilegium.mark("heading",#1)}}
\newcommand\flo@reservepage[5]{\directlua{florilegium.reserve_rect(#1,#2,#3,#4,#5)}}
\newcommand\flo@reservebox[4]{\directlua{florilegium.reserve_box(#1,#2,#3,#4)}}
\newcommand\florilegiumage[1]{\directlua{florilegium.age=#1}}
\newcommand\florilegiumframe[3][]{\directlua{florilegium.frame(#2,#3,"#1")}}
\newcommand\flo@initialdraw[4]{\directlua{florilegium.initial("\luaescapestring{#1}",#2,#3,#4)}}
\newcommand\flo@setinitialfont[1]{\directlua{florilegium.initial_font="\luaescapestring{#1}"}}
\newcommand\flo@hidden[1]{\directlua{florilegium.hidden(#1)}}
\newcommand\flo@empty[1]{\directlua{florilegium.empty_text(#1)}}
\newcommand\flo@numbertext[3]{\pgftext[at={\pgfpoint{#1bp}{#2bp}},left,base]{%
  \fontsize{9}{10}\selectfont\flo@hidden{true}#3\flo@hidden{false}}}
\endinput
